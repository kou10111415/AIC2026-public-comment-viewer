{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "judge_decision": {
      "type": "string",
      "enum": [
        "accepted",
        "revised",
        "confirmed_no_request",
        "recovered_request",
        "uncertain"
      ]
    },
    "final_request_class": {
      "type": "string",
      "enum": [
        "explicit_request",
        "implicit_request",
        "no_request",
        "uncertain"
      ]
    },
    "has_valid_request": {
      "type": "boolean"
    },
    "candidate_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_index": {
            "type": "integer"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "accept",
              "revise",
              "reject"
            ]
          },
          "administrative_target": {
            "type": "boolean"
          },
          "proposal_relation": {
            "type": "boolean"
          },
          "identifiable_action": {
            "type": "boolean"
          },
          "textual_grounding": {
            "type": "boolean"
          },
          "no_unsupported_inference": {
            "type": "boolean"
          },
          "atomic_and_nonredundant": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "candidate_index",
          "verdict",
          "administrative_target",
          "proposal_relation",
          "identifiable_action",
          "textual_grounding",
          "no_unsupported_inference",
          "atomic_and_nonredundant",
          "reason"
        ]
      }
    },
    "final_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_type": {
            "type": "string",
            "enum": [
              "explicit_request",
              "implicit_request"
            ]
          },
          "request_category": {
            "type": "string",
            "enum": [
              "content",
              "agenda",
              "framing",
              "justification",
              "consideration",
              "procedure"
            ]
          },
          "request_summary": {
            "type": "string"
          },
          "requested_action": {
            "type": "string"
          },
          "target_topic": {
            "type": "string"
          },
          "proposal_relation": {
            "type": "string"
          },
          "request_quote": {
            "type": "string"
          },
          "rationale_summary": {
            "type": "string"
          }
        },
        "required": [
          "request_type",
          "request_category",
          "request_summary",
          "requested_action",
          "target_topic",
          "proposal_relation",
          "request_quote",
          "rationale_summary"
        ]
      }
    },
    "judge_reason": {
      "type": "string"
    }
  },
  "required": [
    "judge_decision",
    "final_request_class",
    "has_valid_request",
    "candidate_reviews",
    "final_requests",
    "judge_reason"
  ]
}
